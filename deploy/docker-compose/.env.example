# Copy this file to .env (same directory) before running `docker compose up`.
# .env is gitignored — these are local-only credentials for containers that never leave your
# machine's Docker network; there's nothing here worth protecting beyond "don't commit it anyway."

POSTGRES_PASSWORD=local-dev-only
GRAFANA_ADMIN_PASSWORD=local-dev-only
KEYCLOAK_ADMIN_PASSWORD=local-dev-only
