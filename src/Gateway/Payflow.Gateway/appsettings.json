{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "payments-route": {
        "ClusterId": "payments",
        "Match": { "Path": "/api/payments/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "ledger-route": {
        "ClusterId": "ledger",
        "Match": { "Path": "/api/ledger/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/ledger" } ]
      },
      "fraud-route": {
        "ClusterId": "fraud",
        "Match": { "Path": "/api/fraud/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/fraud" } ]
      },
      "notifications-route": {
        "ClusterId": "notifications",
        "Match": { "Path": "/api/notifications/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "payments": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5218" }
        }
      },
      "ledger": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5204" }
        }
      },
      "fraud": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5277" }
        }
      },
      "notifications": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5229" }
        }
      }
    }
  }
}
